# Copy to .env.local and change only what you need. Every value is optional.

# mock (default): demo data in the browser, ?demo= and ?access= work.
# http: the real API through VITE_API_BASE; demo selectors are ignored.
VITE_API_MODE=mock

# Same-origin path (default) or an absolute http(s) URL of the API.
VITE_API_BASE=/api/v1

# Backend that `npm run dev` and `npm run preview` forward /api to.
API_PROXY_TARGET=http://localhost:8000
